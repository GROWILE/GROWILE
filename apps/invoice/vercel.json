{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --ignore-scripts",
  "rewrites": [
    {
      "source": "/gst-invoice",
      "destination": "/"
    },
    {
      "source": "/without-gst-invoice",
      "destination": "/"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/"
    },
    {
      "source": "/privacy-policy",
      "destination": "/"
    }
  ]
}