{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/pdf",
      "destination": "/pdf/",
      "permanent": false
    },
    {
      "source": "/pdf/:path*",
      "destination": "https://growile-pdf.vercel.app/pdf/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/terms-of-service",
      "destination": "/"
    },
    {
      "source": "/privacy-policy",
      "destination": "/"
    },
    {
      "source": "/pdf/sitemap.xml",
      "destination": "https://growile-pdf.vercel.app/sitemap.xml"
    },
    {
      "source": "/pdf/assets/:path*",
      "destination": "https://growile-pdf.vercel.app/assets/:path*"
    },
    {
      "source": "/pdf/favicon.svg",
      "destination": "https://growile-pdf.vercel.app/favicon.svg"
    },
    {
      "source": "/pdf/:path*",
      "destination": "https://growile-pdf.vercel.app/pdf/:path*"
    },
    {
      "source": "/invoice",
      "destination": "https://growile-invoice.vercel.app/"
    },
    {
      "source": "/invoice/:path*",
      "destination": "https://growile-invoice.vercel.app/:path*"
    },
    {
      "source": "/invoice-assets/:path*",
      "destination": "https://growile-invoice.vercel.app/invoice-assets/:path*"
    },
    {
      "source": "/growile-fevi-icon.png",
      "destination": "https://growile-invoice.vercel.app/growile-fevi-icon.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
